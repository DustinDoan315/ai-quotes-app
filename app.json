{
  "expo": {
    "name": "Inkly",
    "slug": "inkly-daily-vibes",
    "version": "1.1",
    "runtimeVersion": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "inkly",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dustindoan.inkly",
      "buildNumber": "10",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Allow Inkly to use your camera to capture a photo and create a personal reflection from that photo. For example, you can photograph a moment and turn it into a private quote memory.",
        "NSPhotoLibraryUsageDescription": "Allow Inkly to access photos you choose from your library so you can create a personal reflection and save it as a private memory.",
        "NSUserNotificationsUsageDescription": "Inkly can send one daily reminder at the time you choose."
      },
      "entitlements": {
        "aps-environment": "production"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.dustindoan.inkly"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "expo-apple-authentication",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Inkly to use your camera to capture a photo and create a personal reflection from that photo. For example, you can photograph a moment and turn it into a private quote memory."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Inkly to access photos you choose from your library so you can create a personal reflection and save it as a private memory."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "ai-quotes",
          "project": "ai-quotes"
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "daily-quote-reminder",
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#F59E0B"
        }
      ],
      "@react-native-community/datetimepicker",
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
